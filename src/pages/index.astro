---
import Base from "../layouts/Base.astro";
import Intro from "../components/Intro.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Ticker from "../components/sections/Ticker.astro";
import Catalog from "../components/sections/Catalog.astro";
import Update from "../components/sections/Update.astro";
import Socials from "../components/sections/Socials.astro";
import News from "../components/sections/News.astro";
import Notice from "../components/sections/Notice.astro";
import Footer from "../components/sections/Footer.astro";
import { apps, news, site, socials } from "../data/catalog";
import { sortByDateDesc } from "../lib/catalog";

const sortedApps = sortByDateDesc(apps, (app) => app.uploaded);
const sortedNews = sortByDateDesc(news, (item) => item.date);
const navLinks = [
  { label: "Catalog", href: "#catalog" },
  ...(sortedNews.length > 0 ? [{ label: "Updates", href: "#news" }] : []),
  { label: "Support", href: "#support" },
];
---

<Base intro>
  <Intro />
  <Header links={navLinks} />
  <main>
    <Hero />
    <Ticker text={site.ticker} />
    <Catalog apps={sortedApps} />
    <Update site={site} />
    <Socials socials={socials} />
    <News news={sortedNews} />
    <Notice text={site.notice} />
  </main>
  <Footer site={site} />
  <script>
    import "../scripts/motion";
  </script>
</Base>
