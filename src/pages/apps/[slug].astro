---
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import { apps, news } from "../../data/catalog";
import { formatDate, sortByDateDesc, versionAnchor } from "../../lib/catalog";
import type { App } from "../../lib/types";

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props as { app: App };
const changelog = sortByDateDesc(
  news.filter((item) => item.app === app.slug),
  (item) => item.date,
);
const facts = [
  { label: "Platforms", value: app.platforms.join(", ") },
  { label: "File size", value: app.size },
  { label: "Version", value: app.version },
];
---

<Base title={`${app.title} ${app.version} - sbravo`} description={app.description}>
  <main class="shell section-y" style={`--app-accent:${app.accent}`}>
    <a href="/#catalog" class="eyebrow mb-12 inline-flex items-center gap-3 transition-colors hover:text-fg">
      <Logo class="text-lg" title="" /> Back to catalog
    </a>
    <div class="grid grid-cols-1 items-center gap-[clamp(24px,6vw,80px)] md:grid-cols-[minmax(0,320px)_1fr]">
      {
        app.thumb ? (
          <img src={app.thumb} alt="" class="aspect-square w-full max-w-55 rounded-card object-cover md:max-w-none" />
        ) : (
          <div class="detail__orb aspect-square max-w-55 rounded-full md:max-w-none" aria-hidden="true" />
        )
      }
      <div>
        <p class="eyebrow">{app.category} &middot; v{app.version}</p>
        <h1 class="mt-3 mb-5 text-[clamp(48px,9vw,120px)]">{app.title}</h1>
        <p class="max-w-[52ch] text-lg text-muted">{app.description}</p>
        <p class="eyebrow mt-4">by {app.author} &middot; uploaded {formatDate(app.uploaded)}</p>
        <a class="btn btn-primary mt-7" href={app.downloadUrl}>Download v{app.version} &middot; {app.size}</a>
        <p class="eyebrow mt-4">Direct download &middot; No ads &middot; No bundled software</p>
      </div>
    </div>

    <dl
      class="mt-24 grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-px overflow-hidden rounded-card border border-line bg-line"
    >
      {
        facts.map((fact) => (
          <div class="bg-surface p-6">
            <dt class="eyebrow">{fact.label}</dt>
            <dd class="mt-2 text-lg tabular-nums">{fact.value}</dd>
          </div>
        ))
      }
      {
        app.sha256 && (
          <div class="bg-surface p-6">
            <dt class="eyebrow">SHA-256</dt>
            <dd class="mt-2 font-mono text-[13px] text-muted wrap-anywhere">{app.sha256}</dd>
          </div>
        )
      }
      {
        (app.virustotalUrl || app.sourceUrl) && (
          <div class="flex flex-wrap items-center gap-3 bg-surface p-6">
            {app.virustotalUrl && (
              <a class="btn" href={app.virustotalUrl} rel="noopener">
                VirusTotal scan
              </a>
            )}
            {app.sourceUrl && (
              <a class="btn" href={app.sourceUrl} rel="noopener">
                Source code
              </a>
            )}
          </div>
        )
      }
    </dl>

    {
      changelog.length > 0 && (
        <section class="mt-30">
          <h2>Changelog</h2>
          <ol class="mt-8 border-t border-line">
            {changelog.map((item) => (
              <li id={versionAnchor(item.version)} class="border-b border-line py-7">
                <span class="eyebrow tabular-nums">
                  {formatDate(item.date)} &middot; v{item.version}
                </span>
                <h3 class="my-2 text-[22px]">{item.title}</h3>
                <p class="text-muted">{item.summary}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </main>
</Base>

<style>
  .detail__orb {
    background:
      radial-gradient(circle at 30% 30%, #fff8 0, transparent 30%),
      radial-gradient(circle at 60% 70%, var(--app-accent), transparent 70%),
      var(--color-surface);
    box-shadow: 0 30px 120px -20px var(--app-accent);
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    50% {
      transform: translateY(-14px);
    }
  }
</style>
