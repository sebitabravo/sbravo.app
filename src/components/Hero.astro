---
import { apps, site } from "../data/catalog";
import { formatDate } from "../lib/catalog";
import { dateLocale, toLocale, useTranslations } from "../i18n/ui";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const toolCount =
  apps.length > 0 ? ` · ${apps.length} ${t(apps.length === 1 ? "hero.tools.one" : "hero.tools.other")}` : "";
---

<section id="top" class="hero group relative isolate grid min-h-svh grid-rows-[1fr_auto] overflow-hidden" data-hero>
  <div class="hero__stage absolute inset-0 -z-10" aria-hidden="true">
    <div class="hero__fallback absolute inset-0 opacity-0 transition-opacity duration-300 group-[.no-webgl]:opacity-100"></div>
    <canvas class="hero__canvas block h-full w-full group-[.no-webgl]:hidden"></canvas>
    <div class="hero__veil pointer-events-none absolute inset-0"></div>
  </div>

  <div class="shell self-center pt-28">
    <p class="eyebrow hero__line loading:opacity-0">{t("hero.eyebrow")}{toolCount}</p>
    <h1
      class:list={[
        "mt-5 mb-7 flex flex-col",
        // el español es más largo: baja el tamaño para mantener tres líneas
        locale === "es" ? "text-[clamp(30px,7.4vw,112px)]" : "text-[clamp(44px,9.5vw,148px)]",
      ]}
    >
      <span class="block overflow-hidden pb-[0.06em]"><span class="hero__word inline-block">{t("hero.title.1")}</span></span>
      <span class="block overflow-hidden pb-[0.06em]"><span class="hero__word inline-block">{t("hero.title.2")}</span></span>
      <span class="block overflow-hidden pb-[0.06em]">
        <span class="hero__word grad-text inline-block">{t("hero.title.3")}</span>
      </span>
    </h1>
    <p class="hero__line mb-9 max-w-[44ch] text-[clamp(16px,1.6vw,20px)] text-muted loading:opacity-0">
      {t("hero.lead")}
    </p>
    <div class="hero__line flex flex-wrap gap-3 loading:pointer-events-none loading:opacity-0">
      <a class="btn btn-primary" href="#catalog">{t("hero.browse")}</a>
      {site.supportUrl && <a class="btn" href="#support">{t("hero.support")}</a>}
    </div>
  </div>

  <div class="hero__line shell flex justify-between pb-7 loading:opacity-0">
    <span class="eyebrow">
      {t("hero.updated")} &middot; <span class="tabular-nums">{formatDate(site.updated, dateLocale[locale])}</span>
    </span>
    <span class="eyebrow inline-flex items-center gap-2.5 max-sm:hidden" aria-hidden="true">
      {t("hero.scroll")} <i class="hero__drip h-8 w-px bg-linear-to-b from-fg to-transparent"></i>
    </span>
  </div>
</section>

<style>
  /* capas de gradiente múltiples: más legibles en CSS que como clases arbitrarias */
  .hero__fallback {
    background:
      radial-gradient(40% 45% at 70% 45%, rgb(200 180 135 / 0.45), transparent 70%),
      radial-gradient(30% 35% at 62% 58%, rgb(224 201 143 / 0.32), transparent 70%);
  }
  .hero__veil {
    background:
      linear-gradient(90deg, var(--color-ink) 0%, transparent 55%),
      linear-gradient(0deg, var(--color-ink), transparent 30%);
  }
  /* en pantallas angostas el orbe queda detrás del texto: se apaga antes de llegar al titular */
  @media (max-width: 640px) {
    .hero__veil {
      background:
        linear-gradient(90deg, var(--color-ink) 0%, transparent 70%),
        linear-gradient(180deg, transparent 0%, rgb(6 6 10 / 0.72) 26%, var(--color-ink) 52%);
    }
  }
  .hero__drip {
    animation: drip 1.8s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__drip {
      animation: none;
    }
  }
  @keyframes drip {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const hero = document.querySelector<HTMLElement>("[data-hero]")!;
  const canvas = hero.querySelector<HTMLCanvasElement>(".hero__canvas")!;
  const stage = hero.querySelector<HTMLElement>(".hero__stage")!;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // el escenario se apaga a medida que se sale del hero, para que el corte al ticker no sea seco
  let heroHeight = hero.offsetHeight;
  const fadeStage = () => {
    const progress = Math.min(window.scrollY / Math.max(heroHeight, 1), 1);
    // ease-in: el orbe se mantiene arriba y recién se apaga al acercarse al borde
    stage.style.opacity = String(1 - progress * progress * 0.85);
  };
  if (!reduced) {
    let fadeFrame = 0;
    const scheduleFade = () => {
      if (fadeFrame) return;
      fadeFrame = requestAnimationFrame(() => {
        fadeFrame = 0;
        fadeStage();
      });
    };
    window.addEventListener("scroll", scheduleFade, { passive: true });
    window.addEventListener(
      "resize",
      () => {
        heroHeight = hero.offsetHeight;
        scheduleFade();
      },
      { passive: true },
    );
    fadeStage();
  }

  const hasWebGL = (() => {
    try {
      return !!document.createElement("canvas").getContext("webgl2");
    } catch {
      return false;
    }
  })();

  let playIntro: ((duration?: number) => Promise<void>) | undefined;
  // si el intro se abre antes de que three.js termine de cargar, la escena arranca apenas esté lista
  let introOpened = Boolean((window as Window & { __introOpened?: boolean }).__introOpened);

  if (hasWebGL && !reduced) {
    // three.js se carga en un chunk aparte para no bloquear el primer render
    import("../scenes/hero").then(({ initHero }) => {
      const sceneApi = initHero(canvas, stage, { onContextLost: () => hero.classList.add("no-webgl") });
      playIntro = sceneApi.playIntro;
      if (introOpened) playIntro(1.6);
      // si la página entra al back/forward cache no se destruye: al volver, el loop se reanuda solo
      window.addEventListener("pagehide", (event) => {
        if (!event.persisted) sceneApi.dispose();
      });
      (window as Window & { __heroReady?: boolean }).__heroReady = true;
      window.dispatchEvent(new CustomEvent("hero:ready"));
    });
  } else {
    hero.classList.add("no-webgl");
  }

  const onIntroOpen = () => {
    introOpened = true;
    playIntro?.(2.6);
    if (reduced) return;
    gsap
      .timeline({ delay: 0.35 })
      .to(".hero__word", { y: 0, duration: 1.2, ease: "expo.out", stagger: 0.1 })
      .to(".hero__line", { opacity: 1, duration: 0.9, ease: "power2.out", stagger: 0.08 }, "-=0.8");
  };

  if (introOpened) onIntroOpen();
  else window.addEventListener("intro:open", onIntroOpen, { once: true });
</script>
