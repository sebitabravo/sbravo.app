---
import { apps, site } from "../data/catalog";
import { formatDate } from "../lib/catalog";
---

<section id="top" class="hero group relative isolate grid min-h-svh grid-rows-[1fr_auto] overflow-hidden" data-hero>
  <div class="hero__stage absolute inset-0 -z-10" aria-hidden="true">
    <div class="hero__fallback absolute inset-0 opacity-0 transition-opacity duration-600 group-[.no-webgl]:opacity-100"></div>
    <canvas class="hero__canvas block h-full w-full group-[.no-webgl]:hidden"></canvas>
    <div class="hero__veil pointer-events-none absolute inset-0"></div>
  </div>

  <div class="shell self-center pt-24">
    <p class="eyebrow hero__line loading:opacity-0">
      Free software hub{apps.length > 0 && ` · ${apps.length} tools`}
    </p>
    <h1 class="mt-5 mb-7 flex flex-col text-[clamp(44px,9.5vw,148px)]">
      <span class="block overflow-hidden pb-[0.06em]"><span class="hero__word inline-block">Tools that</span></span>
      <span class="block overflow-hidden pb-[0.06em]"><span class="hero__word inline-block">feel like</span></span>
      <span class="block overflow-hidden pb-[0.06em]"><span class="hero__word grad-text inline-block">magic.</span></span>
    </h1>
    <p class="hero__line mb-9 max-w-[44ch] text-[clamp(16px,1.6vw,20px)] text-muted loading:opacity-0">
      {site.tagline} Lightweight apps, honest changelogs, zero bloat.
    </p>
    <div class="hero__line flex flex-wrap gap-3 loading:opacity-0">
      <a class="btn btn-primary" href="#catalog">Browse catalog</a>
      <a class="btn" href={site.supportUrl}>Support the project</a>
    </div>
  </div>

  <div class="hero__line shell flex justify-between pb-7 loading:opacity-0">
    <span class="eyebrow">Last update &middot; <span class="tabular-nums">{formatDate(site.updated)}</span></span>
    <span class="eyebrow inline-flex items-center gap-2.5">
      Scroll <i class="hero__drip h-8 w-px bg-linear-to-b from-fg to-transparent" aria-hidden="true"></i>
    </span>
  </div>
</section>

<style>
  /* capas de gradiente múltiples: más legibles en CSS que como clases arbitrarias */
  .hero__fallback {
    background:
      radial-gradient(40% 45% at 70% 45%, rgb(124 92 255 / 0.45), transparent 70%),
      radial-gradient(30% 35% at 62% 58%, rgb(0 212 255 / 0.35), transparent 70%);
  }
  .hero__veil {
    background:
      linear-gradient(90deg, var(--color-ink) 0%, transparent 55%),
      linear-gradient(0deg, var(--color-ink), transparent 30%);
  }
  .hero__drip {
    animation: drip 1.8s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__drip {
      animation: none;
    }
  }
  @keyframes drip {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const hero = document.querySelector<HTMLElement>("[data-hero]")!;
  const canvas = hero.querySelector<HTMLCanvasElement>(".hero__canvas")!;
  const stage = hero.querySelector<HTMLElement>(".hero__stage")!;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const hasWebGL = (() => {
    try {
      return !!document.createElement("canvas").getContext("webgl2");
    } catch {
      return false;
    }
  })();

  let playIntro: ((duration?: number) => Promise<void>) | undefined;

  if (hasWebGL && !reduced) {
    // three.js se carga en un chunk aparte para no bloquear el primer render
    import("../scenes/hero").then(({ initHero }) => {
      const sceneApi = initHero(canvas, stage);
      playIntro = sceneApi.playIntro;
      window.addEventListener("pagehide", () => sceneApi.dispose(), { once: true });
      (window as Window & { __heroReady?: boolean }).__heroReady = true;
      window.dispatchEvent(new CustomEvent("hero:ready"));
    });
  } else {
    hero.classList.add("no-webgl");
  }

  window.addEventListener(
    "intro:open",
    () => {
      playIntro?.(2.6);
      if (reduced) return;
      gsap
        .timeline({ delay: 0.35 })
        .to(".hero__word", { y: 0, duration: 1.2, ease: "expo.out", stagger: 0.1 })
        .to(".hero__line", { opacity: 1, duration: 0.9, ease: "power2.out", stagger: 0.08 }, "-=0.8");
    },
    { once: true },
  );
</script>
