---
interface Props {
  class?: string;
  /** muestra el wordmark junto a la marca */
  wordmark?: boolean;
  title?: string;
}

const { class: className, wordmark = false, title = "sbravo" } = Astro.props;
const gradientId = `sb-grad-${Math.random().toString(36).slice(2, 8)}`;
---

<span class:list={["inline-flex items-center gap-[0.35em]", className]}>
  <svg
    viewBox="0 0 64 64"
    class="h-[1em] w-[1em] shrink-0"
    role={title ? "img" : undefined}
    aria-label={title || undefined}
    aria-hidden={title ? undefined : "true"}
  >
    <defs>
      <linearGradient id={gradientId} x1="12" y1="8" x2="52" y2="56" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#7c5cff" />
        <stop offset="1" stop-color="#00d4ff" />
      </linearGradient>
    </defs>
    <path
      d="M44 18.5A12 12 0 1 0 32 32a12 12 0 1 1-12 13.5"
      fill="none"
      stroke={`url(#${gradientId})`}
      stroke-width="9"
      stroke-linecap="round"
    />
    <path d="M54 2.5l2.2 5.3L61.5 10l-5.3 2.2L54 17.5l-2.2-5.3L46.5 10l5.3-2.2Z" fill="#00d4ff" />
  </svg>
  {wordmark && <span class="font-display font-bold tracking-[-0.04em]">sbravo</span>}
</span>
