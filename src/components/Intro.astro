---
import Logo from "./Logo.astro";

const letters = "sbravo".split("");
---

<div class="intro pointer-events-none fixed inset-0 z-100 grid place-items-center" data-intro aria-hidden="true">
  <div class="intro__panel intro__panel--top absolute inset-x-0 top-0 h-[50.5%] bg-ink"></div>
  <div class="intro__panel intro__panel--bottom absolute inset-x-0 bottom-0 h-[50.5%] bg-ink"></div>
  <div class="relative grid justify-items-center gap-5">
    <div class="flex overflow-hidden text-[clamp(44px,10vw,120px)] leading-none">
      <span class="intro__letter inline-block"><Logo /></span>
      {
        letters.map((letter) => (
          <span class="intro__letter grad-text inline-block font-display font-bold tracking-[-0.04em]">{letter}</span>
        ))
      }
    </div>
    <div class="intro__bar h-px w-[min(240px,60vw)] overflow-hidden bg-line"><i class="block h-full bg-(image:--grad)"></i></div>
  </div>
  <span class="intro__count eyebrow absolute right-(--gutter) bottom-7 text-sm text-fg tabular-nums">000</span>
  <span class="intro__label eyebrow absolute bottom-7 left-(--gutter)">Loading experience</span>
</div>

<noscript>
  <style>
    .intro {
      display: none !important;
    }
    body.is-loading {
      overflow: auto !important;
    }
    .hero__word {
      transform: none !important;
    }
    .hero__line {
      opacity: 1 !important;
    }
  </style>
</noscript>

<script>
  import { gsap } from "gsap";

  const root = document.querySelector<HTMLElement>("[data-intro]")!;
  const count = root.querySelector<HTMLElement>(".intro__count")!;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // el intro completo se ve una vez por sesión; volver desde una app no lo repite
  const seen = (() => {
    try {
      const value = sessionStorage.getItem("sb-intro-seen") === "1";
      sessionStorage.setItem("sb-intro-seen", "1");
      return value;
    } catch {
      return false;
    }
  })();

  // al recargar, Chrome restaura el scroll y el intro terminaría revelando la mitad de la página
  history.scrollRestoration = "manual";
  if (!seen) window.scrollTo(0, 0);

  const finish = () => {
    root.remove();
    document.body.classList.remove("is-loading");
    window.dispatchEvent(new CustomEvent("intro:done"));
  };

  // espera a que three.js esté listo, con tope para conexiones lentas o sin WebGL
  const heroReady = new Promise<void>((resolve) => {
    if ((window as Window & { __heroReady?: boolean }).__heroReady) return resolve();
    window.addEventListener("hero:ready", () => resolve(), { once: true });
    setTimeout(resolve, 3500);
  });

  if (reduced || seen) {
    window.dispatchEvent(new CustomEvent("intro:open"));
    finish();
    if (location.hash) document.querySelector(location.hash)?.scrollIntoView();
  } else {
    const progress = { value: 0 };
    const render = () => (count.textContent = String(Math.round(progress.value)).padStart(3, "0"));

    gsap.to(".intro__letter", { y: 0, duration: 1, ease: "expo.out", stagger: 0.06, delay: 0.15 });
    const loading = gsap.to(progress, { value: 85, duration: 1.8, ease: "power2.inOut", onUpdate: render });
    gsap.to(".intro__bar i", { scaleX: 0.85, duration: 1.8, ease: "power2.inOut" });

    Promise.all([heroReady, document.fonts.ready, loading.then()]).then(() => {
      gsap
        .timeline({ onComplete: finish })
        .to(progress, { value: 100, duration: 0.45, ease: "power1.out", onUpdate: render })
        .to(".intro__bar i", { scaleX: 1, duration: 0.45, ease: "power1.out" }, "<")
        .to(".intro__letter", { y: "-105%", duration: 0.6, ease: "expo.out", stagger: 0.04 })
        .to([".intro__count", ".intro__label", ".intro__bar"], { opacity: 0, duration: 0.3 }, "<")
        .add(() => window.dispatchEvent(new CustomEvent("intro:open")))
        .to(".intro__panel--top", { yPercent: -100, duration: 1.2, ease: "expo.inOut" })
        .to(".intro__panel--bottom", { yPercent: 100, duration: 1.2, ease: "expo.inOut" }, "<");
    });
  }
</script>
