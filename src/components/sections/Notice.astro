---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<aside class="border-y border-amber/18 bg-amber/5 py-4.5" aria-label="Download notice" role="note" data-reveal>
  <div class="shell flex items-start gap-3">
    <svg viewBox="0 0 24 24" fill="none" class="size-5.5 shrink-0 text-amber" aria-hidden="true">
      <path d="M12 3.5 21 20H3l9-16.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M12 9v5m0 2.5v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <p class="text-xs leading-relaxed text-muted"><strong class="mr-1 text-fg">Heads up</strong> {text}</p>
  </div>
</aside>
