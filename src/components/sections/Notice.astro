---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<aside class="notice" aria-label="Download notice" role="note" data-reveal>
  <div class="container notice__inner">
    <span class="notice__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M12 3.5 21 20H3l9-16.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
        <path d="M12 9v5m0 2.5v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </span>
    <p><strong>Heads up</strong> {text}</p>
  </div>
</aside>

<style>
  .notice {
    padding-block: 18px;
    border-block: 1px solid rgba(255, 181, 71, 0.18);
    background: rgba(255, 181, 71, 0.045);
  }
  .notice__inner {
    display: flex;
    align-items: flex-start;
    gap: 13px;
  }
  .notice__icon {
    width: 22px;
    height: 22px;
    flex: none;
    color: #ffb547;
  }
  .notice__icon svg {
    width: 100%;
    height: 100%;
  }
  .notice p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }
  .notice strong {
    margin-right: 5px;
    color: var(--text);
  }
</style>
