---
import type { NewsItem } from "../../lib/types";
import { formatDate, versionAnchor } from "../../lib/catalog";
import { splitWords } from "../../scripts/split";
import Arrow from "../icons/Arrow.astro";
import { dateLocale, localePath, toLocale, useTranslations } from "../../i18n/ui";

interface Props {
  news: NewsItem[];
}

const { news } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

{
  news.length > 0 && (
    <section
      id="news"
      class="section-y bg-linear-to-b from-transparent via-white/2 to-transparent"
      aria-labelledby="news-title"
    >
      <div class="shell md:grid md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] md:items-start md:gap-[9vw]">
        <div class="mb-8.5 md:sticky md:top-[18vh] md:mb-0" data-reveal>
          <p class="eyebrow">{t("news.eyebrow")}</p>
          <h2 id="news-title" class="mt-4 text-section">
            {t("news.title.1")} {t("news.title.2")}
          </h2>
          <p class="mt-4 max-w-[38ch] text-muted">{t("news.lead")}</p>
        </div>
        <ol class="news__timeline relative grid pl-4.75">
          {news.map((item) => (
            <li class="relative min-w-0 pb-7.5 pl-4.25" data-reveal>
              <span
                class="absolute top-1 -left-4.75 size-2.25 rounded-full border-2 border-sand bg-ink shadow-[0_2px_12px_rgb(200_180_135/0.45)]"
                aria-hidden="true"
              />
              <time
                class="font-mono text-xs tracking-[0.08em] text-muted uppercase tabular-nums"
                datetime={item.date}
              >
                {formatDate(item.date, dateLocale[locale])}
              </time>
              <a
                class="group/news mt-2 block wrap-anywhere"
                href={`${localePath(locale, `/apps/${item.app}/`)}#${versionAnchor(item.version)}`}
              >
                <h3
                  class="inline-block text-card transition-colors group-hover/news:text-sand"
                  data-split
                >
                  {splitWords(item.title[locale]).map((token) =>
                    /^\s+$/u.test(token) ? token : <span class="inline-block">{token}</span>
                  )}
                </h3>
                <p class="mt-2 mb-2.5 text-[13px] leading-[1.55] text-muted">{item.summary[locale]}</p>
                <span class="inline-flex min-h-8 items-center gap-1.75 font-mono text-xs text-fg">
                  {t("news.version")} {item.version} <Arrow class="size-3.5 text-sand" />
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .news__timeline::before {
    position: absolute;
    top: 8px;
    bottom: 18px;
    left: 4px;
    width: 1px;
    content: "";
    background: linear-gradient(var(--color-sand), var(--color-line) 80%, transparent);
  }
</style>
