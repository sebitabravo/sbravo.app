---
import type { NewsItem } from "../../lib/types";
import { formatDate, versionAnchor } from "../../lib/catalog";
import { splitWords } from "../../scripts/split";

interface Props {
  news: NewsItem[];
}

const { news } = Astro.props;
---

<section class="news section" aria-labelledby="news-title">
  <div class="container news__layout">
    <div class="news__intro" data-reveal>
      <p class="eyebrow">Fresh from the workshop</p>
      <h2 id="news-title">Latest <span class="grad-text">updates.</span></h2>
      <p>New releases, fixes, and small details worth knowing.</p>
    </div>
    <ol class="news__timeline">
      {news.map((item) => (
        <li class="news__item" data-reveal>
          <span class="news__dot" aria-hidden="true"></span>
          <time class="news__date" datetime={item.date}>{formatDate(item.date)}</time>
          <a class="news__link" href={`/apps/${item.app}#${versionAnchor(item.version)}`}>
            <h3 class="news__title" data-split>
              {splitWords(item.title).map((token) =>
                /^\s+$/u.test(token) ? token : <span class="news__word">{token}</span>
              )}
            </h3>
            <p>{item.summary}</p>
            <span class="news__version">Version {item.version} <span aria-hidden="true">↗</span></span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .news {
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.018), transparent);
  }
  .news__intro {
    margin-bottom: 34px;
  }
  .news__intro h2 {
    margin-top: 14px;
    font-size: clamp(34px, 6vw, 64px);
  }
  .news__intro > p:last-child {
    max-width: 38ch;
    margin: 16px 0 0;
    color: var(--muted);
  }
  .news__timeline {
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0 0 0 19px;
    list-style: none;
  }
  .news__timeline::before {
    position: absolute;
    top: 8px;
    bottom: 18px;
    left: 4px;
    width: 1px;
    content: "";
    background: linear-gradient(var(--accent), var(--line) 80%, transparent);
  }
  .news__item {
    position: relative;
    min-width: 0;
    padding: 0 0 30px 17px;
  }
  .news__dot {
    position: absolute;
    top: 4px;
    left: -19px;
    width: 9px;
    height: 9px;
    border: 2px solid var(--accent-2);
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 16px rgba(0, 212, 255, 0.55);
  }
  .news__date {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .news__link {
    display: block;
    margin-top: 8px;
    overflow-wrap: anywhere;
  }
  .news__title {
    display: inline-block;
    font-size: clamp(17px, 2.2vw, 21px);
  }
  .news__word {
    display: inline-block;
  }
  .news__link > p {
    margin: 8px 0 10px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.55;
  }
  .news__version {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    gap: 7px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .news__version span {
    color: var(--accent-2);
  }
  .news__link:hover .news__title {
    color: var(--accent-2);
  }
  @media (min-width: 860px) {
    .news__layout {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 9vw;
      align-items: start;
    }
    .news__intro {
      position: sticky;
      top: 18vh;
      margin-bottom: 0;
    }
  }
</style>
