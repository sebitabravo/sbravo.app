---
import type { NewsItem } from "../../lib/types";
import { formatDate, versionAnchor } from "../../lib/catalog";
import { splitWords } from "../../scripts/split";
import Arrow from "../icons/Arrow.astro";

interface Props {
  news: NewsItem[];
}

const { news } = Astro.props;
---

{
  news.length > 0 && (
    <section
      id="news"
      class="section-y bg-linear-to-b from-transparent via-white/2 to-transparent"
      aria-labelledby="news-title"
    >
      <div class="shell min-[860px]:grid min-[860px]:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] min-[860px]:items-start min-[860px]:gap-[9vw]">
        <div class="mb-8.5 min-[860px]:sticky min-[860px]:top-[18vh] min-[860px]:mb-0" data-reveal>
          <p class="eyebrow">Fresh from the workshop</p>
          <h2 id="news-title" class="mt-3.5 text-[clamp(34px,6vw,64px)]">
            Latest <span class="grad-text">updates.</span>
          </h2>
          <p class="mt-4 max-w-[38ch] text-muted">New releases, fixes, and small details worth knowing.</p>
        </div>
        <ol class="news__timeline relative grid pl-4.75">
          {news.map((item) => (
            <li class="relative min-w-0 pb-7.5 pl-4.25" data-reveal>
              <span
                class="absolute top-1 -left-4.75 size-2.25 rounded-full border-2 border-cyan bg-ink shadow-[0_0_16px_rgb(0_212_255/0.55)]"
                aria-hidden="true"
              />
              <time
                class="font-mono text-[10px] tracking-[0.08em] text-muted uppercase tabular-nums"
                datetime={item.date}
              >
                {formatDate(item.date)}
              </time>
              <a
                class="group/news mt-2 block wrap-anywhere"
                href={`/apps/${item.app}#${versionAnchor(item.version)}`}
              >
                <h3
                  class="inline-block text-[clamp(17px,2.2vw,21px)] transition-colors group-hover/news:text-cyan"
                  data-split
                >
                  {splitWords(item.title).map((token) =>
                    /^\s+$/u.test(token) ? token : <span class="inline-block">{token}</span>
                  )}
                </h3>
                <p class="mt-2 mb-2.5 text-[13px] leading-[1.55] text-muted">{item.summary}</p>
                <span class="inline-flex min-h-8 items-center gap-1.75 font-mono text-[10px] text-fg">
                  Version {item.version} <Arrow class="size-3.5 text-cyan" />
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .news__timeline::before {
    position: absolute;
    top: 8px;
    bottom: 18px;
    left: 4px;
    width: 1px;
    content: "";
    background: linear-gradient(var(--color-violet), var(--color-line) 80%, transparent);
  }
</style>
