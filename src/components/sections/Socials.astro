---
import type { Social } from "../../lib/types";
import Arrow from "../icons/Arrow.astro";
import { toLocale, useTranslations } from "../../i18n/ui";

interface Props {
  socials: Social[];
}

const { socials } = Astro.props;
const t = useTranslations(toLocale(Astro.currentLocale));
// trazos genéricos (sin logos de marca) según el tipo de red
const icons = {
  code: "M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14",
  video: "M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5v-11ZM10 9l5 3-5 3V9Z",
  post: "M5 5h14v10H9l-4 4V5ZM9 9h6M9 12h4",
  people: "M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5 8a5 5 0 0 1 10 0M16 11a2.5 2.5 0 1 0 0-5M17.5 19a4.5 4.5 0 0 0-2.6-4.1",
};
const iconPath = (label: string) => {
  if (/github|gitlab|code/i.test(label)) return icons.code;
  if (/youtube|video|twitch/i.test(label)) return icons.video;
  if (/^x$|twitter|bluesky|mastodon|threads/i.test(label)) return icons.post;
  return icons.people;
};
---

<section class="section-y" aria-labelledby="socials-title">
  <div class="shell">
    <div class="mb-[clamp(28px,5vw,48px)]" data-reveal>
      <p class="eyebrow">{t("socials.eyebrow")}</p>
      <h2 id="socials-title" class="mt-4 text-section">
        {t("socials.title.1")} {t("socials.title.2")}
      </h2>
    </div>
    <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
      {
        socials.map((social) => (
          <a
            class="group/social flex min-h-26 min-w-0 items-center gap-4 rounded-card border border-line bg-linear-145 from-white/4.5 to-white/1 p-5 transition-colors duration-200 hover:border-sand/30 hover:from-sand/6 hover:to-bronze/4 max-sm:gap-3 max-sm:p-4 active:scale-[0.99]"
            href={social.url}
            rel="me noopener"
            aria-label={`${social.label}: ${social.handle}`}
            data-magnetic
            data-reveal
          >
            <span class="grid size-12 shrink-0 place-items-center rounded-tile border border-line bg-white/4 text-sand">
              <svg viewBox="0 0 24 24" fill="none" class="size-5.5" aria-hidden="true">
                <path
                  d={iconPath(social.label)}
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="grid min-w-0 gap-1">
              <strong class="font-display text-[15px] wrap-anywhere">{social.label}</strong>
              <span class="text-xs text-muted wrap-anywhere">{social.handle}</span>
            </span>
            <Arrow class="ml-auto size-4 shrink-0 text-muted transition-transform duration-200 group-hover/social:translate-x-0.5" />
          </a>
        ))
      }
    </div>
  </div>
</section>
