---
import type { Social } from "../../lib/types";

interface Props {
  socials: Social[];
}

const { socials } = Astro.props;
---

<section class="socials section" aria-labelledby="socials-title">
  <div class="container">
    <div class="socials__intro" data-reveal>
      <p class="eyebrow">Stay in the loop</p>
      <h2 id="socials-title">Find your <span class="grad-text">people.</span></h2>
    </div>
    <div class="socials__grid">
      {socials.map((social) => (
        <a
          class="social-card"
          href={social.url}
          aria-label={`${social.label}: ${social.handle}`}
          data-magnetic
          data-reveal
        >
          <span class="social-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path
                d="M7 17 17 7M8 7h9v9"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="social-card__copy">
            <strong>{social.label}</strong>
            <span>{social.handle}</span>
          </span>
          <span class="social-card__action" aria-hidden="true">Connect</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .socials__intro {
    margin-bottom: clamp(28px, 5vw, 48px);
  }
  .socials__intro h2 {
    margin-top: 14px;
    font-size: clamp(34px, 6vw, 64px);
  }
  .socials__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }
  .social-card {
    display: flex;
    min-width: 0;
    min-height: 104px;
    align-items: center;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.012));
    transition: border-color 0.25s, background 0.25s;
  }
  .social-card:hover {
    border-color: rgba(0, 212, 255, 0.3);
    background: linear-gradient(145deg, rgba(0, 212, 255, 0.06), rgba(124, 92, 255, 0.035));
  }
  .social-card__icon {
    display: grid;
    width: 48px;
    height: 48px;
    flex: none;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--accent-2);
  }
  .social-card__icon svg {
    width: 22px;
    height: 22px;
  }
  .social-card__copy {
    display: grid;
    min-width: 0;
    gap: 4px;
  }
  .social-card__copy strong {
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: 15px;
  }
  .social-card__copy > span {
    overflow-wrap: anywhere;
    color: var(--muted);
    font-size: 12px;
  }
  .social-card__action {
    margin-left: auto;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    white-space: nowrap;
  }
  .social-card:focus-visible {
    outline: 2px solid var(--accent-2);
    outline-offset: 3px;
  }
  @media (min-width: 640px) {
    .socials__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }
  @media (max-width: 380px) {
    .social-card {
      gap: 11px;
      padding: 16px;
    }
    .social-card__action {
      font-size: 9px;
    }
  }
</style>
