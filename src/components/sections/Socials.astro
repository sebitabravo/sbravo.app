---
import type { Social } from "../../lib/types";
import Arrow from "../icons/Arrow.astro";

interface Props {
  socials: Social[];
}

const { socials } = Astro.props;
// trazos genéricos (sin logos de marca) según el tipo de red
const iconPath = (label: string) =>
  /youtube|video|twitch/i.test(label)
    ? "M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5v-11ZM10 9l5 3-5 3V9Z"
    : "M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5 8a5 5 0 0 1 10 0M16 11a2.5 2.5 0 1 0 0-5M17.5 19a4.5 4.5 0 0 0-2.6-4.1";
---

<section class="section-y" aria-labelledby="socials-title">
  <div class="shell">
    <div class="mb-[clamp(28px,5vw,48px)]" data-reveal>
      <p class="eyebrow">Stay in the loop</p>
      <h2 id="socials-title" class="mt-3.5 text-[clamp(34px,6vw,64px)]">
        Find your <span class="grad-text">people.</span>
      </h2>
    </div>
    <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 sm:gap-5">
      {
        socials.map((social) => (
          <a
            class="flex min-h-26 min-w-0 items-center gap-4 rounded-card border border-line bg-linear-145 from-white/4.5 to-white/1 p-5 transition-colors duration-250 hover:border-cyan/30 hover:from-cyan/6 hover:to-violet/4 max-[380px]:gap-3 max-[380px]:p-4"
            href={social.url}
            aria-label={`${social.label}: ${social.handle}`}
            data-magnetic
            data-reveal
          >
            <span class="grid size-12 shrink-0 place-items-center rounded-[15px] border border-line bg-white/4 text-cyan">
              <svg viewBox="0 0 24 24" fill="none" class="size-5.5" aria-hidden="true">
                <path
                  d={iconPath(social.label)}
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="grid min-w-0 gap-1">
              <strong class="font-display text-[15px] wrap-anywhere">{social.label}</strong>
              <span class="text-xs text-muted wrap-anywhere">{social.handle}</span>
            </span>
            <Arrow class="ml-auto size-4 shrink-0 text-muted" />
          </a>
        ))
      }
    </div>
  </div>
</section>
