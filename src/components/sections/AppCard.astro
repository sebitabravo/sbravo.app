---
import type { App } from "../../lib/types";
import { formatDate } from "../../lib/catalog";
import { splitWords } from "../../scripts/split";
import Arrow from "../icons/Arrow.astro";

interface Props {
  app: App;
}

const { app } = Astro.props;
const tokens = splitWords(app.title);
const platforms = app.platforms.length > 1 ? `${app.platforms[0]} +${app.platforms.length - 1}` : app.platforms[0];
---

<article
  class="app-card group/card relative min-w-0 overflow-hidden rounded-card border border-line bg-surface transition-colors duration-200 transform-3d hover:border-(--app-accent)/45 hover:shadow-[0_18px_50px_-12px] hover:shadow-(--app-accent)/25"
  style={`--app-accent: ${app.accent}`}
  data-app-card
  data-reveal
>
  <div class="app-card__glare pointer-events-none absolute -top-32.5 -left-32.5 z-10 size-65 opacity-0 transition-opacity duration-250 group-hover/card:opacity-100"></div>
  <div class="app-card__art relative grid min-h-39 place-items-center overflow-hidden border-b border-line" aria-hidden="true">
    {
      app.thumb ? (
        <img src={app.thumb} alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
      ) : (
        <>
          <div class="app-card__blob absolute aspect-square w-28 -rotate-20 border border-(--app-accent)/55" />
          <div class="app-card__blob absolute aspect-square w-39 rotate-35 border border-(--app-accent)/25" />
          <span class="z-10 grid aspect-square w-14.5 place-items-center rounded-[17px] border border-(--app-accent)/60 bg-(--app-accent)/18 font-display text-[23px] font-semibold text-fg">
            {app.title.slice(0, 1)}
          </span>
        </>
      )
    }
  </div>
  <div class="relative z-20 p-5 max-[420px]:p-4">
    <div class="flex items-center justify-between gap-3">
      <h3 class="min-w-0 text-[clamp(19px,2vw,23px)] wrap-anywhere" data-split>
        {tokens.map((token) => (/^\s+$/u.test(token) ? token : <span class="inline-block">{token}</span>))}
      </h3>
      <span class="shrink-0 font-mono text-[11px] text-(--app-accent) tabular-nums">v{app.version}</span>
    </div>
    <p class="mt-3.5 mb-5 min-h-[4.65em] text-sm leading-[1.55] text-muted">{app.description}</p>
    <div
      class="flex items-center justify-between gap-3 border-b border-line pb-4 text-[11px] text-muted max-[420px]:flex-col max-[420px]:items-start max-[420px]:gap-1"
    >
      <span>By {app.author} &middot; {platforms} &middot; {app.size}</span>
      <time class="tabular-nums" datetime={app.uploaded}>{formatDate(app.uploaded)}</time>
    </div>
    <div class="flex items-center justify-between gap-3 pt-4">
      <span class="rounded-full border border-(--app-accent)/30 px-2.5 py-1 font-mono text-[11px] text-(--app-accent)">
        {app.category}
      </span>
      <a
        class="group/link inline-flex min-h-11 items-center gap-2 text-[13px] font-semibold text-fg"
        href={`/apps/${app.slug}`}
        aria-label={`View ${app.title} details`}
      >
        Explore
        <Arrow
          class="size-4.5 text-(--app-accent) transition-transform duration-200 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
        />
      </a>
    </div>
  </div>
</article>

<style>
  /* gradientes que dependen de --app-accent; motion.ts mueve el glare con transform */
  .app-card__glare {
    background: radial-gradient(circle, color-mix(in srgb, var(--app-accent) 20%, transparent), transparent 72%);
  }
  .app-card__art {
    background:
      radial-gradient(50% 80% at 50% 100%, color-mix(in srgb, var(--app-accent) 22%, transparent), transparent),
      linear-gradient(135deg, rgb(255 255 255 / 0.035), transparent 65%);
  }
  .app-card__blob {
    border-radius: 30% 70% 58% 42% / 42% 38% 62% 58%;
    box-shadow: inset 0 0 32px color-mix(in srgb, var(--app-accent) 15%, transparent);
  }
</style>
