---
import type { App } from "../../lib/types";
import { formatDate } from "../../lib/catalog";
import { splitWords } from "../../scripts/split";
import { dateLocale, localePath, toLocale, useTranslations } from "../../i18n/ui";
import Arrow from "../icons/Arrow.astro";

interface Props {
  app: App;
}

const { app } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const tokens = splitWords(app.title);
const platforms = app.platforms.length > 1 ? `${app.platforms[0]} +${app.platforms.length - 1}` : app.platforms[0];
// grafema completo: slice(0, 1) partiría un emoji por la mitad
const monogram = [...new Intl.Segmenter().segment(app.title.trim())][0]?.segment ?? "?";
---

<article
  class="app-card group/card relative min-w-0 overflow-hidden rounded-card border border-line bg-surface transition-[border-color,box-shadow] duration-200 transform-3d focus-within:border-(--app-accent)/45 hover:border-(--app-accent)/45 hover:shadow-[0_18px_50px_-12px] hover:shadow-(--app-accent)/25 active:scale-[0.99]"
  style={`--app-accent: ${app.accent}`}
  data-app-card
  data-reveal
>
  <div
    class="app-card__glare pointer-events-none absolute -top-32.5 -left-32.5 z-10 size-65 opacity-0 transition-opacity duration-250 group-hover/card:opacity-100"
  >
  </div>
  <div class="app-card__art relative grid min-h-39 place-items-center overflow-hidden border-b border-line" aria-hidden="true">
    <div class="app-card__blob absolute aspect-square w-28 -rotate-20 border border-(--app-accent)/55"></div>
    <div class="app-card__blob absolute aspect-square w-39 rotate-35 border border-(--app-accent)/25"></div>
    {
      app.thumb ? (
        <img
          src={app.thumb}
          alt=""
          loading="lazy"
          decoding="async"
          onerror="this.remove()"
          class="absolute inset-0 size-full object-cover"
        />
      ) : (
        <span class="z-10 grid aspect-square w-14.5 place-items-center rounded-tile border border-(--app-accent)/60 bg-(--app-accent)/18 font-display text-[23px] font-semibold text-fg">
          {monogram}
        </span>
      )
    }
  </div>
  <div class="relative z-20 p-5 max-sm:p-4">
    <div class="flex items-start justify-between gap-3">
      <h3 class="min-w-0 text-card wrap-anywhere" data-split>
        {tokens.map((token) => (/^\s+$/u.test(token) ? token : <span class="inline-block">{token}</span>))}
      </h3>
      <span class="app-card__accent mt-1 max-w-[9ch] shrink-0 truncate font-mono text-xs tabular-nums" title={app.version}>
        v{app.version}
      </span>
    </div>
    <p class="mt-3.5 mb-5 line-clamp-3 min-h-[4.65em] text-sm leading-[1.55] text-muted">{app.description[locale]}</p>
    <div
      class="flex items-center justify-between gap-3 border-b border-line pb-4 text-xs text-muted max-sm:flex-col max-sm:items-start max-sm:gap-1"
    >
      <span class="min-w-0 wrap-anywhere">{platforms} &middot; {app.size}</span>
      <time class="shrink-0 tabular-nums" datetime={app.uploaded}>{formatDate(app.uploaded, dateLocale[locale])}</time>
    </div>
    <div class="flex items-center justify-between gap-3 pt-4">
      <span
        class="app-card__accent min-w-0 truncate rounded-full border border-(--app-accent)/30 px-2.5 py-1 font-mono text-xs"
        title={app.category[locale]}
      >
        {app.category[locale]}
      </span>
      <div class="flex shrink-0 items-center gap-4">
        {
          app.platforms.length === 1 && (
            <a
              class="app-card__accent relative z-40 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold"
              href={app.downloadUrl}
            >
              {t("card.download")}
            </a>
          )
        }
        <a
          class="group/link inline-flex min-h-11 shrink-0 items-center gap-2 text-sm font-semibold text-fg after:absolute after:inset-0 after:z-30 after:content-['']"
          href={localePath(locale, `/apps/${app.slug}/`)}
        >
          {t("card.explore")} <span class="sr-only">{app.title}</span>
          <Arrow
            class="app-card__accent size-4.5 transition-transform duration-200 group-hover/card:translate-x-0.5 group-hover/card:-translate-y-0.5"
          />
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  /* gradientes que dependen de --app-accent; motion.ts mueve el glare con transform */
  .app-card__glare {
    background: radial-gradient(circle, color-mix(in srgb, var(--app-accent) 20%, transparent), transparent 72%);
  }
  .app-card__art {
    background:
      radial-gradient(50% 80% at 50% 100%, color-mix(in srgb, var(--app-accent) 22%, transparent), transparent),
      linear-gradient(135deg, rgb(255 255 255 / 0.035), transparent 65%);
  }
  .app-card__blob {
    border-radius: 30% 70% 58% 42% / 42% 38% 62% 58%;
    box-shadow: inset 0 0 32px color-mix(in srgb, var(--app-accent) 15%, transparent);
  }
  /* aclarar el acento asegura 4.5:1 sobre surface incluso con violeta */
  .app-card__accent {
    color: color-mix(in srgb, var(--app-accent) 80%, white);
  }
</style>
