---
import type { App } from "../../lib/types";
import { formatDate } from "../../lib/catalog";
import { splitWords } from "../../scripts/split";

interface Props {
  app: App;
}

const { app } = Astro.props;
const tokens = splitWords(app.title);
---

<article class="app-card" style={`--app-accent: ${app.accent}`} data-app-card data-reveal>
  <div class="app-card__art" aria-hidden="true">
    <div class="app-card__shape app-card__shape--one"></div>
    <div class="app-card__shape app-card__shape--two"></div>
    <span class="app-card__mark">{app.title.slice(0, 1)}</span>
  </div>
  <div class="app-card__body">
    <div class="app-card__heading">
      <h3 class="app-card__title" data-split>
        {tokens.map((token) =>
          /^\s+$/u.test(token) ? token : <span class="app-card__word">{token}</span>
        )}
      </h3>
      <span class="app-card__version">v{app.version}</span>
    </div>
    <p class="app-card__description">{app.description}</p>
    <div class="app-card__meta">
      <span>By {app.author} &middot; {app.platforms[0]}{app.platforms.length > 1 && ` +${app.platforms.length - 1}`} &middot; {app.size}</span>
      <time datetime={app.uploaded}>{formatDate(app.uploaded)}</time>
    </div>
    <div class="app-card__footer">
      <span class="app-card__category">{app.category}</span>
      <a class="app-card__link" href={`/apps/${app.slug}`} aria-label={`View ${app.title} details`}>
        Explore <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>

<style>
  .app-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    transform-style: preserve-3d;
    transition: box-shadow 0.3s, border-color 0.3s;
  }
  .app-card::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    content: "";
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      260px circle at var(--pointer-x, 50%) var(--pointer-y, 50%),
      color-mix(in srgb, var(--app-accent) 20%, transparent),
      transparent 72%
    );
    transition: opacity 0.25s;
  }
  .app-card:hover {
    border-color: color-mix(in srgb, var(--app-accent) 45%, var(--line));
    box-shadow: 0 18px 50px color-mix(in srgb, var(--app-accent) 14%, transparent);
  }
  .app-card:hover::before {
    opacity: 1;
  }
  .app-card__art {
    position: relative;
    display: grid;
    min-height: 156px;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(50% 80% at 50% 100%, color-mix(in srgb, var(--app-accent) 22%, transparent), transparent),
      linear-gradient(135deg, rgba(255, 255, 255, 0.035), transparent 65%);
  }
  .app-card__shape {
    position: absolute;
    width: 112px;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--app-accent) 55%, transparent);
    border-radius: 30% 70% 58% 42% / 42% 38% 62% 58%;
    box-shadow: inset 0 0 32px color-mix(in srgb, var(--app-accent) 15%, transparent);
    transform: rotate(-20deg);
  }
  .app-card__shape--two {
    width: 156px;
    border-color: color-mix(in srgb, var(--app-accent) 25%, transparent);
    transform: rotate(35deg);
  }
  .app-card__mark {
    z-index: 1;
    display: grid;
    width: 58px;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--app-accent) 60%, transparent);
    border-radius: 17px;
    background: color-mix(in srgb, var(--app-accent) 18%, var(--bg-elev));
    color: var(--text);
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 600;
    box-shadow: 0 0 34px color-mix(in srgb, var(--app-accent) 24%, transparent);
  }
  .app-card__body {
    position: relative;
    z-index: 2;
    padding: 20px;
  }
  .app-card__heading,
  .app-card__meta,
  .app-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .app-card__title {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: clamp(19px, 2vw, 23px);
  }
  .app-card__word {
    display: inline-block;
  }
  .app-card__version,
  .app-card__category {
    flex: none;
    color: var(--app-accent);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .app-card__description {
    min-height: 4.65em;
    margin: 14px 0 20px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }
  .app-card__meta {
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 11px;
  }
  .app-card__meta time {
    font-variant-numeric: tabular-nums;
  }
  .app-card__footer {
    padding-top: 15px;
  }
  .app-card__category {
    padding: 5px 9px;
    border: 1px solid color-mix(in srgb, var(--app-accent) 30%, var(--line));
    border-radius: 999px;
  }
  .app-card__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
  }
  .app-card__link span {
    color: var(--app-accent);
    font-size: 18px;
    transition: transform 0.2s;
  }
  .app-card__link:hover span {
    transform: translate(2px, -2px);
  }
  @media (max-width: 420px) {
    .app-card__body {
      padding: 17px;
    }
    .app-card__meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
