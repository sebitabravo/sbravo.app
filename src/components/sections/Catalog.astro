---
import type { App } from "../../lib/types";
import AppCard from "./AppCard.astro";

interface Props {
  apps: App[];
}

const { apps } = Astro.props;
---

<section class="catalog section" id="catalog" aria-labelledby="catalog-title">
  <div class="catalog__glow" data-parallax aria-hidden="true"></div>
  <div class="container">
    <div class="catalog__intro" data-reveal>
      <p class="eyebrow">Small tools, useful every day</p>
      <h2 id="catalog-title">The <span class="grad-text">catalog.</span></h2>
      <p class="catalog__lead">Thoughtful software, made to do one thing well.</p>
    </div>
    {apps.length > 0 ? (
      <div class="catalog__grid">
        {apps.map((app) => <AppCard app={app} />)}
      </div>
    ) : (
      <p class="catalog__empty" role="status">New tools are on the way. Check back soon.</p>
    )}
  </div>
</section>

<style>
  .catalog {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .catalog__glow {
    position: absolute;
    z-index: -1;
    top: 5%;
    right: -15%;
    width: min(65vw, 700px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 92, 255, 0.12), transparent 68%);
    pointer-events: none;
  }
  .catalog__intro {
    margin-bottom: clamp(32px, 6vw, 64px);
  }
  .catalog__intro h2 {
    margin-top: 14px;
    font-size: clamp(36px, 7vw, 76px);
  }
  .catalog__lead {
    max-width: 48ch;
    margin: 16px 0 0;
    color: var(--muted);
  }
  .catalog__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .catalog__empty {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--muted);
  }
  @media (min-width: 640px) {
    .catalog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }
  @media (min-width: 1024px) {
    .catalog__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
  }
</style>
