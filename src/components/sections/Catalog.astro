---
import type { App } from "../../lib/types";
import AppCard from "./AppCard.astro";
import Arrow from "../icons/Arrow.astro";
import { socials } from "../../data/catalog";
import { toLocale, useTranslations } from "../../i18n/ui";

interface Props {
  apps: App[];
}

const { apps } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const github = socials.find((social) => /github/i.test(social.label)) ?? socials[0];
// mientras no haya releases, la sección explica el formato de ficha en vez de disculparse
const preview = [
  { title: t("catalog.empty.item1.title"), body: t("catalog.empty.item1.body") },
  { title: t("catalog.empty.item2.title"), body: t("catalog.empty.item2.body") },
  { title: t("catalog.empty.item3.title"), body: t("catalog.empty.item3.body") },
];
---

<section class="section-y relative isolate overflow-hidden" id="catalog" aria-labelledby="catalog-title">
  <div
    class="pointer-events-none absolute top-[5%] -right-[15%] -z-10 aspect-square w-[min(65vw,700px)] rounded-full bg-[radial-gradient(circle,rgb(124_92_255/0.12),transparent_68%)]"
    data-parallax
    aria-hidden="true"
  >
  </div>
  <div class="shell">
    <div class="mb-[clamp(32px,6vw,64px)]" data-reveal>
      <p class="eyebrow">{t("catalog.eyebrow")}</p>
      <h2 id="catalog-title" class="mt-4 text-section">
        {t("catalog.title.1")} <span class="grad-text">{t("catalog.title.2")}</span>
      </h2>
      <p class="mt-4 max-w-[48ch] text-muted">{t("catalog.lead")}</p>
    </div>
    {
      apps.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 lg:gap-6">
          {apps.map((app) => (
            <AppCard app={app} />
          ))}
        </div>
      ) : (
        <div
          class="relative isolate overflow-hidden rounded-card border border-line bg-surface px-[clamp(22px,5vw,52px)] py-[clamp(24px,5vw,52px)]"
          data-reveal
        >
          <div
            class="pointer-events-none absolute -top-40 -right-28 -z-10 aspect-square w-105 rounded-full bg-[radial-gradient(circle,rgb(124_92_255/0.16),transparent_70%)]"
            aria-hidden="true"
          >
          </div>
          <div class="grid gap-10 md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] md:items-center md:gap-[6vw]">
            <div>
              <p class="eyebrow">{t("catalog.empty.eyebrow")}</p>
              <h3 class="mt-4 text-[clamp(26px,3.4vw,40px)]">
                {t("catalog.empty.title.1")} <span class="grad-text">{t("catalog.empty.title.2")}</span>
              </h3>
              <p class="mt-4 max-w-[42ch] text-sm text-muted">{t("catalog.empty.lead")}</p>
              {
                github && (
                  <a class="btn mt-7" href={github.url} rel="me noopener">
                    {t("catalog.empty.cta")} <Arrow class="size-4" />
                  </a>
                )
              }
            </div>
            <ol class="grid gap-px overflow-hidden rounded-tile border border-line bg-line">
              {
                preview.map((item, index) => (
                  <li class="bg-ink/60 p-5">
                    <div class="flex items-baseline gap-3">
                      <span class="font-mono text-xs text-cyan tabular-nums">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                      <h4 class="text-[15px] font-semibold">{item.title}</h4>
                    </div>
                    <p class="mt-2 pl-[calc(1.5rem+0.75rem)] text-sm text-muted">{item.body}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      )
    }
  </div>
</section>
