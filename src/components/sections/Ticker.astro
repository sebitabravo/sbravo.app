---
import Spark from "../icons/Spark.astro";
import { toLocale, useTranslations } from "../../i18n/ui";

interface Props {
  text: string;
}

const { text } = Astro.props;
const t = useTranslations(toLocale(Astro.currentLocale));
const rows = [
  { reverse: false, item: "text-xs font-mono uppercase tracking-[0.16em] text-muted" },
  { reverse: true, item: "font-display text-[clamp(28px,4vw,56px)] font-semibold leading-[1.15] tracking-[-0.02em]" },
];
---

<section class="ticker relative overflow-hidden border-y border-line bg-surface py-4.5" aria-label={t("ticker.label")}>
  {
    rows.map((row, index) => (
      <div class:list={["ticker__row", { "ticker__row--reverse mt-2": row.reverse }]} data-ticker-row>
        <div class="flex w-max whitespace-nowrap will-change-transform" data-ticker-track aria-hidden="true">
          {[0, 1, 2, 3].map((n) => (
            <span
              class:list={[
                "inline-flex items-center gap-[clamp(20px,4vw,56px)] px-[clamp(20px,4vw,56px)]",
                row.item,
                row.reverse && (n % 2 === 0 ? "ticker__outline" : "text-fg"),
              ]}
            >
              {text}
              <Spark class="size-[0.6em] shrink-0 text-cyan" />
            </span>
          ))}
        </div>
        {index === 0 && <span class="sr-only">{text}</span>}
      </div>
    ))
  }
  <button
    type="button"
    class="absolute right-(--gutter) bottom-2 grid size-9 place-items-center rounded-full border border-line bg-ink/80 text-muted transition-colors hover:text-fg"
    aria-pressed="false"
    aria-label={t("ticker.pause")}
    data-ticker-toggle
    data-label-pause={t("ticker.pause")}
    data-label-play={t("ticker.play")}
  >
    <svg viewBox="0 0 16 16" class="size-3.5" fill="currentColor" aria-hidden="true">
      <path class="ticker__icon-pause" d="M4 3h3v10H4zM9 3h3v10H9z" />
      <path class="ticker__icon-play hidden" d="M4 3l9 5-9 5z" />
    </svg>
  </button>
</section>

<style>
  /* -webkit-text-stroke no tiene utilidad en Tailwind */
  .ticker__outline {
    color: transparent;
    -webkit-text-stroke: 1px rgb(236 235 245 / 0.45);
  }
  [aria-pressed="true"] .ticker__icon-pause {
    display: none;
  }
  [aria-pressed="true"] .ticker__icon-play {
    display: block;
  }
</style>
