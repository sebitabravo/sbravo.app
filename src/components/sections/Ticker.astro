---
interface Props {
  text: string;
}

const { text } = Astro.props;
const tracks = ["ticker__row--forward", "ticker__row--reverse"];
---

<section class="ticker" aria-label="Site updates">
  {tracks.map((trackClass, index) => (
    <div class:list={["ticker__row", trackClass]} data-ticker-row>
      <div class="ticker__track" data-ticker-track aria-hidden="true">
        {[0, 1, 2, 3].map(() => (
          <span class="ticker__item">{text}<span class="ticker__separator">✳</span></span>
        ))}
      </div>
      {index === 0 && <span class="sr-only">{text}</span>}
    </div>
  ))}
</section>

<style>
  .ticker {
    overflow: hidden;
    padding-block: 18px;
    border-block: 1px solid var(--line);
    background: var(--bg-elev);
  }
  .ticker__row + .ticker__row {
    margin-top: 8px;
  }
  .ticker__track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    will-change: transform;
  }
  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(20px, 4vw, 56px);
    padding-inline: clamp(20px, 4vw, 56px);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ticker__row--reverse .ticker__item {
    color: transparent;
    -webkit-text-stroke: 1px rgba(236, 235, 245, 0.45);
    font-family: var(--font-display);
    font-size: clamp(36px, 6vw, 84px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-transform: none;
  }
  .ticker__row--reverse .ticker__item:nth-child(even) {
    color: var(--text);
    -webkit-text-stroke: 0;
  }
  .ticker__separator {
    color: var(--accent-2);
    font-size: 0.8em;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
