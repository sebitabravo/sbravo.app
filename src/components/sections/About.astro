---
import Logo from "../Logo.astro";
import Arrow from "../icons/Arrow.astro";
import { socials } from "../../data/catalog";
import { toLocale, useTranslations } from "../../i18n/ui";

const t = useTranslations(toLocale(Astro.currentLocale));
const github = socials.find((social) => /github/i.test(social.label)) ?? socials[0];
const facts = [
  { title: t("about.fact1.title"), body: t("about.fact1.body") },
  { title: t("about.fact2.title"), body: t("about.fact2.body") },
  { title: t("about.fact3.title"), body: t("about.fact3.body") },
];
---

<section class="section-y scroll-mt-20" id="about" aria-labelledby="about-title">
  <div class="shell grid grid-cols-1 gap-11 md:grid-cols-[minmax(0,1.15fr)_minmax(280px,0.85fr)] md:items-center md:gap-[8vw]">
    <div data-reveal>
      <p class="eyebrow">{t("about.eyebrow")}</p>
      <h2 id="about-title" class="mt-4 max-w-[16ch] text-section">
        {t("about.title.1")} {t("about.title.2")}
      </h2>
      <p class="mt-6 max-w-[54ch] text-muted">{t("about.body.1")}</p>
      <p class="mt-4 max-w-[54ch] text-muted">{t("about.body.2")}</p>
      {
        github && (
          <a class="btn mt-7" href={github.url} rel="me noopener">
            {t("about.cta")} <Arrow class="size-4" />
          </a>
        )
      }
    </div>
    <aside class="relative isolate min-w-0 overflow-hidden rounded-card border border-line bg-surface p-[clamp(24px,4vw,40px)]" data-reveal>
      <Logo wordmark class="text-[clamp(26px,3vw,36px)]" title="" />
      <dl class="mt-8 grid gap-5 border-t border-line pt-6">
        {
          facts.map((fact) => (
            <div>
              <dt class="eyebrow">{fact.title}</dt>
              <dd class="mt-1.5 text-sm text-muted">{fact.body}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</section>
