---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/sections/Footer.astro";
import { site } from "../data/catalog";
import { toLocale, type Locale } from "../i18n/ui";

const locale = toLocale(Astro.currentLocale);
const updated = "2026-10-29";

interface Block {
  title: string;
  body: string[];
}

const content: Record<Locale, { eyebrow: string; title: string; lead: string; blocks: Block[]; contact: string }> = {
  es: {
    eyebrow: "Legal",
    title: "Privacidad",
    lead: "Este sitio no pide datos personales. Esto es todo lo que pasa cuando lo visitas.",
    blocks: [
      {
        title: "Qué se guarda",
        body: [
          "No hay registro ni cuentas. No hay analítica, píxeles de seguimiento ni publicidad. La única base de datos es la de los comentarios, descrita más abajo.",
          "Las tipografías se sirven desde este mismo dominio: el navegador no hace pedidos a Google Fonts ni a terceros.",
        ],
      },
      {
        title: "Almacenamiento local",
        body: [
          "Se guarda una marca en sessionStorage llamada sb-intro-seen para no repetir la animación de entrada en la misma visita. Se borra al cerrar la pestaña y no identifica a nadie.",
          "Si cierras el aviso de descargas, se guarda en localStorage (sb-notice-dismissed) una huella del texto del aviso para no volver a mostrarlo. Solo vuelve a aparecer si el aviso cambia.",
          "No se usan cookies.",
        ],
      },
      {
        title: "Hosting y registros",
        body: [
          "El proveedor de hosting puede registrar datos técnicos de cada pedido, como dirección IP, navegador y fecha, para entregar el sitio y protegerse de abuso.",
          "Esos registros no se cruzan con otros datos ni se usan para perfilado.",
        ],
      },
      {
        title: "Enlaces externos",
        body: [
          "Los enlaces a GitHub, YouTube, X y GitHub Sponsors salen de este sitio. A partir de ahí rigen las políticas de cada plataforma.",
          "Las descargas pueden alojarse en GitHub Releases, con las mismas condiciones.",
          "Los comentarios de cada ficha se guardan en una base de datos propia en Cloudflare. Se almacena el nombre que escribas (opcional), el comentario y la fecha. No se pide correo. La IP no se guarda: solo un hash con sal que sirve para frenar spam y no permite recuperarla. Antes de publicar, Cloudflare Turnstile verifica que no seas un bot. Los comentarios son públicos y puedo borrar los que sean spam o abusivos.",
        ],
      },
      {
        title: "Tus derechos",
        body: [
          "La Ley 19.628 sobre protección de la vida privada, y desde el 1 de diciembre de 2026 la Ley 21.719, reconocen los derechos de acceso, rectificación, supresión y oposición. Si quieres que se corrija o borre un comentario tuyo, escríbeme indicando la ficha y el texto.",
          "Si crees que hay un dato tuyo involucrado, escríbeme por GitHub y te respondo a la brevedad.",
        ],
      },
    ],
    contact: "Contacto",
  },
  en: {
    eyebrow: "Legal",
    title: "Privacy",
    lead: "This site does not ask for personal data. This is everything that happens when you visit it.",
    blocks: [
      {
        title: "What is stored",
        body: [
          "There are no sign-ups or accounts. No analytics, tracking pixels or advertising. The only database is the one for comments, described below.",
          "Fonts are served from this same domain: your browser makes no requests to Google Fonts or any third party.",
        ],
      },
      {
        title: "Local storage",
        body: [
          "A sessionStorage flag named sb-intro-seen keeps the intro animation from replaying during the same visit. It is cleared when the tab closes and identifies no one.",
          "If you dismiss the download notice, localStorage (sb-notice-dismissed) keeps a fingerprint of the notice text so it is not shown again. It only reappears if the notice changes.",
          "No cookies are used.",
        ],
      },
      {
        title: "Hosting and logs",
        body: [
          "The hosting provider may log technical data for each request, such as IP address, browser and date, to deliver the site and protect it from abuse.",
          "Those logs are not combined with other data or used for profiling.",
        ],
      },
      {
        title: "External links",
        body: [
          "Links to GitHub, YouTube, X and GitHub Sponsors leave this site. From there, each platform's policy applies.",
          "Downloads may be hosted on GitHub Releases, under the same conditions.",
          "Comments on each listing are stored in a database of my own on Cloudflare. It keeps the name you type (optional), the comment and the date. No email is asked for. Your IP is not stored: only a salted hash used to stop spam, which cannot be turned back into the IP. Before publishing, Cloudflare Turnstile checks that you are not a bot. Comments are public and I may delete spam or abusive ones.",
        ],
      },
      {
        title: "Your rights",
        body: [
          "Chile's Law 19.628, and from December 1, 2026 Law 21.719, grant rights of access, rectification, deletion and objection. If you want a comment of yours corrected or deleted, write to me with the listing and the text.",
          "If you believe data of yours is involved, reach out on GitHub and I will get back to you.",
        ],
      },
    ],
    contact: "Contact",
  },
};

const { eyebrow, title, lead, blocks, contact } = content[locale];
const github = "https://github.com/sebitabravo";
---

<Base title={`${title} - ${site.name}`} description={lead}>
  <Header />
  <main id="main" tabindex="-1" class="section-y pt-32">
    <article class="shell max-w-[72ch]">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-4 text-section">{title}</h1>
      <p class="mt-5 max-w-[52ch] text-muted">{lead}</p>
      <p class="mt-3 font-mono text-xs text-muted">
        <time datetime={updated}>{updated}</time>
      </p>
      <div class="mt-14 grid gap-10">
        {
          blocks.map((block) => (
            <section class="grid gap-3 border-t border-line pt-7">
              <h2 class="text-card">{block.title}</h2>
              {block.body.map((paragraph) => (
                <p class="text-sm leading-[1.65] text-muted">{paragraph}</p>
              ))}
            </section>
          ))
        }
        <section class="grid gap-3 border-t border-line pt-7">
          <h2 class="text-card">{contact}</h2>
          <p class="text-sm leading-[1.65] text-muted">
            <a class="text-fg underline decoration-line underline-offset-4 transition-colors hover:text-sand" href={github} rel="me noopener">
              github.com/sebitabravo
            </a>
          </p>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</Base>
